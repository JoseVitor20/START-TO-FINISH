# Ativar rewrite engine
RewriteEngine On
RewriteBase /

# Redirecionar para WWW (com HTTPS)
RewriteCond %{HTTP_HOST} ^starttofinish.com.br$ [NC]
RewriteRule ^(.*)$ https://starttofinish.com.br/$1 [R=301,L]

# Remover "public" da URL quando for acessado diretamente
RewriteCond %{THE_REQUEST} \s/public/([^\s?]*) [NC]
RewriteRule ^public/(.*)$ /$1 [R=301,L]

# Direcionar tudo para a pasta public/, exceto arquivos estáticos
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf|map|json|xml|txt|pdf|zip|rar)$ [NC]
RewriteRule ^(.*)$ /public/$1 [L]

# Proteção contra acesso a arquivos sensíveis
<FilesMatch "^(\.env|\.git|\.htaccess|composer\.(json|lock)|package\.(json|lock)|yarn\.lock|node_modules|vendor|storage)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Permitir cache para melhor performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>